<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Amount_Minimum_10</fullName>
    <active>true</active>
    <description>Prevents saving an Adoption record when Amount is less than 10.</description>
    <errorConditionFormula>Amount__c &lt; 10</errorConditionFormula>
    <errorDisplayField>Amount__c</errorDisplayField>
    <errorMessage>Amount must be at least 10.</errorMessage>
</ValidationRule>
